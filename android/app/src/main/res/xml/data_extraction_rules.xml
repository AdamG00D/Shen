<?xml version="1.0" encoding="utf-8"?>
<!-- منع نسخ بيانات التطبيق احتياطياً أو نقلها لجهاز آخر (المفاتيح والإعدادات — متشفّرة بمفتاح الجهاز أصلاً ومش هتتفتح في جهاز تاني). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
